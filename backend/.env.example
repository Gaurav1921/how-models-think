CORS_ORIGINS=["http://localhost:5173"]

# CONTENT_DIR is optional. It defaults to the backend/content directory next
# to the app package, resolved as an absolute path. Only set it if you need
# to point at a different content directory; a relative value here is
# resolved against the process's current working directory, not this file,
# so prefer an absolute path if you do override it.
# CONTENT_DIR=/absolute/path/to/content
